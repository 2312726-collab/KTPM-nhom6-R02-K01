# ==============================================================================
# Dockerfile cho Test Runner — Đồ án Kiểm thử Phần mềm (Nhóm 6)
# Mealie v3.28.0 + Property-Based Testing (Hypothesis)
#
# TRƯỚC KHI BUILD: mealie_src/ phải có sẵn trên host
#   git clone https://github.com/mealie-recipes/mealie.git mealie_src
#   cd mealie_src && git checkout 0552eaa4a80031b8572849cca0ed95d07f1be001 && cd ..
#
# Build image:
#   docker compose -f docker-compose.test.yml build test-runner
#
# Chạy P5 riêng:
#   docker compose -f docker-compose.test.yml run --rm test-runner
#
# Chạy toàn bộ suite:
#   docker compose -f docker-compose.test.yml run --rm test-runner pytest tests/ -v --tb=long
# ==============================================================================

# Dùng Python 3.12-slim; phiên bản gần với Mealie v3.28.0 backend (Python 3.12)
FROM python:3.12-slim

LABEL maintainer="2312695-netizen"
LABEL description="KTPM Nhom6 - PBT Test Runner for Mealie v3.28.0"
LABEL mealie.version="v3.28.0"
LABEL mealie.sha="0552eaa4a80031b8572849cca0ed95d07f1be001"

# Không tạo .pyc để container sạch hơn
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Sao chép requirements trước để tận dụng Docker layer cache
COPY requirements-test.txt .

# Cài dependencies kiểm thử (không cần SQLAlchemy hay toàn bộ deps Mealie server)
# string_utils.py chỉ dùng fractions và re — stdlib Python
RUN pip install --no-cache-dir -r requirements-test.txt

# Sao chép cấu hình pytest
COPY pytest.ini .

# Sao chép toàn bộ tests/
COPY tests/ tests/

# Sao chép phần source Mealie cần thiết cho P5
# (mealie_src/ bị .gitignore — phải có sẵn trên host trước khi build)
# Chỉ cần parser_utils, không cần toàn bộ mealie source
COPY mealie_src/mealie/services/parser_services/parser_utils/ \
     mealie_src/mealie/services/parser_services/parser_utils/

# Tạo __init__.py cần thiết để Python nhận diện package path
RUN mkdir -p mealie_src/mealie/services/parser_services && \
    touch mealie_src/__init__.py && \
    touch mealie_src/mealie/__init__.py && \
    touch mealie_src/mealie/services/__init__.py && \
    touch mealie_src/mealie/services/parser_services/__init__.py

# Thêm mealie_src vào PYTHONPATH (tương tự pytest.ini pythonpath = . mealie_src)
ENV PYTHONPATH="/app:/app/mealie_src"

# Mặc định: chạy P5 với marker pbt, truyền exit code thật (không || true)
CMD ["pytest", "tests/unit_tests/test_pbt_fraction.py", "-v", "--tb=long", "-m", "pbt"]